{
  "name": "@plex-exporter/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync(path.join('dist','config'),{recursive:true});fs.copyFileSync(path.join('src','config','swagger.yaml'),path.join('dist','config','swagger.yaml'))\"",
    "start:prod": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "migrate:drizzle": "tsx src/scripts/migrate-to-drizzle.ts"
  },
  "dependencies": {
    "@plex-exporter/shared": "file:../../packages/shared",
    "axios": "^1.16.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "lru-cache": "^11.3.6",
    "node-cron": "^4.2.1",
    "resend": "^6.12.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/ui": "^4.1.5",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
